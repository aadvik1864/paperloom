# Flask
SECRET_KEY=generate-a-unique-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=generate-a-different-random-secret-of-at-least-32-characters
FLASK_ENV=development
PORT=5000
ADMIN_PROFILE_NAME=Administrator
ADMIN_PASSWORD=
# Production only: shared Redis (use rediss:// on hosted infrastructure)
RATELIMIT_STORAGE_URI=memory://
# Comma-separated exact browser origins; set to your deployed HTTPS site in production.
CORS_ORIGINS=http://localhost:5173
# Set only when running behind a known, trusted reverse proxy.
PROXY_HOPS=0

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/research_platform

# Cloudflare R2
R2_BUCKET_NAME=your-r2-bucket-name
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
